+bool lv_draw_sdl_letter_warm(lv_draw_ctx_t * draw_ctx, const lv_font_t * font_p, uint32_t letter)
+{
+    lv_font_glyph_dsc_t g;
+    if(!lv_font_get_glyph_dsc(font_p, &g, letter, '\0') || g.box_w == 0 || g.box_h == 0) return false;
+    bool found, in_cache;
+    SDL_Texture * texture = glyph_texture_obtain((lv_draw_sdl_ctx_t *) draw_ctx, font_p, letter, &g, &found, &in_cache);
+    if(texture && !in_cache) SDL_DestroyTexture(texture);
+    return !found;
+}
