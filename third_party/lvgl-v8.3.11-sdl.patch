+bool lv_draw_sdl_img_warm(lv_draw_ctx_t * draw_ctx, const void * src)
+{
+    lv_draw_sdl_ctx_t * ctx = (lv_draw_sdl_ctx_t *) draw_ctx;
+    size_t key_size;
+    lv_draw_sdl_cache_key_head_img_t * key = lv_draw_sdl_texture_img_key_create(src, 0, &key_size);
+    bool found = false, in_cache = false;
+    lv_draw_sdl_img_header_t * header = NULL;
+    SDL_Texture * texture = lv_draw_sdl_texture_cache_get_with_userdata(ctx, key, key_size, &found, (void **) &header);
+    if(!found) lv_draw_sdl_img_load_texture(ctx, key, key_size, src, 0, &texture, &header, &in_cache);
+    SDL_free(key);
+    if(!found && texture && header && !in_cache) {     /* same clean-up as lv_draw_sdl_img_core */
+        if(!header->managed) SDL_DestroyTexture(texture);
+        lv_mem_free(header);
+    }
+    return !found;
+}
